                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          }
        },
        "summary": "Logically remove a case document",
        "tags": [
          "Case documents"
        ]
      },
      "get": {
        "operationId": "GetCaseDocumentMetadata",
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
