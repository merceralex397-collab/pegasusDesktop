  "info": {
    "description": "Versioned JSON API for the Pegasus native desktop (product version 0.1.0-alpha.1).",
    "title": "Pegasus Desktop Gateway",
    "version": "0.1.0-alpha.1"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/cases/{caseId}/vehicle": {
      "get": {
        "description": "Returns confirmed vehicle evidence, lookup observations and provenance.",
        "operationId": "GetVehicleEvidence",
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseVehicleResponse"
                }
              }
            },
            "description": "OK"
          },
          "304": {
            "description": "Not Modified"
          },
          "401": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/PegasusProblem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/PegasusProblem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/PegasusProblem"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Get vehicle evidence",
        "tags": [
          "VehicleEndpoints"
        ]
      }
    },
    "/api/v1/cases/{caseId}/vehicle/lookups": {
      "post": {
        "description": "Queues a provider lookup through the server-side vehicle workflow.",
        "operationId": "RequestVehicleLookup",
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehicleLookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleLookupResponse"
                }
              }
            },
            "description": "Accepted"
          },
          "400": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/PegasusProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/PegasusProblem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/PegasusProblem"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/PegasusProblem"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/PegasusProblem"
                }
