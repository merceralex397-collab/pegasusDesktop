  "info": {
    "description": "Versioned JSON API for the Pegasus native desktop (product version 0.1.0-alpha.1).",
    "title": "Pegasus Desktop Gateway",
    "version": "0.1.0-alpha.1"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/cases/{caseId}/documents": {
      "get": {
        "operationId": "ListCaseDocuments",
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "default": 25,
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "semanticRole",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "includeRemoved",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            },
            "description": "OK"
          },
          "304": {
            "description": "Not Modified"
          },
          "404": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "List case document metadata",
        "tags": [
          "Case documents"
        ]
      }
    },
    "/api/v1/cases/{caseId}/documents/upload-session": {
      "post": {
        "operationId": "StartCaseDocumentUploadSession",
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
